<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card when nothing is being read (tap: the To read shelf). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Nothing on the go"
        android:textColor="@color/widget_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick your next book from To read"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: "Reading · N books", a shelf row of covers (tap: the book's page), then this year's
     challenge (tap: reading activity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reading"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- The shelf row: up to four covers with their progress (tap: the book's page); "+N" when more are being read
         (tap: the Reading shelf). Hidden, and the empty card shown instead, when nothing is being read. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/shelf_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/shelf_spot_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shelf_cover_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Cover"
                android:scaleType="fitEnd" />

            <ProgressBar
                android:id="@+id/shelf_progress_0"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/shelf_spot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shelf_cover_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Cover"
                android:scaleType="fitEnd" />

            <ProgressBar
                android:id="@+id/shelf_progress_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/shelf_spot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shelf_cover_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Cover"
                android:scaleType="fitEnd" />

            <ProgressBar
                android:id="@+id/shelf_progress_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/shelf_spot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shelf_cover_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Cover"
                android:scaleType="fitEnd" />

            <ProgressBar
                android:id="@+id/shelf_progress_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent" />
        </LinearLayout>
        <TextView
            android:id="@+id/shelf_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_accent"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

        <include layout="@layout/widget_empty" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_challenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_challenge_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_challenge_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/widget_track"
            android:progressTint="@color/widget_accent" />
    </LinearLayout>
</LinearLayout>

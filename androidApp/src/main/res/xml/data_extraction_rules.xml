<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same as backup_rules.xml, for the Google account backup and for moving to a new
     phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mybooks.db" />
        <include domain="database" path="mybooks.db-wal" />
        <include domain="database" path="mybooks.db-shm" />
        <include domain="sharedpref" path="mybooks.xml" />
        <include domain="file" path="covers" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mybooks.db" />
        <include domain="database" path="mybooks.db-wal" />
        <include domain="database" path="mybooks.db-shm" />
        <include domain="sharedpref" path="mybooks.xml" />
        <include domain="file" path="covers" />
    </device-transfer>
</data-extraction-rules>

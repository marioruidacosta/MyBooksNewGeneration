<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier: what Android's automatic backup (Google account) keeps. Only the library database,
     the app's settings (sort orders, challenges' preferences, hidden suggestions, appearance) and the cover photos
     taken in the app. Not the community sign-in (it shouldn't follow the phone) nor New in Portugal's cache. -->
<full-backup-content>
    <include domain="database" path="mybooks.db" />
    <include domain="database" path="mybooks.db-wal" />
    <include domain="database" path="mybooks.db-shm" />
    <include domain="sharedpref" path="mybooks.xml" />
    <include domain="file" path="covers" />
</full-backup-content>
